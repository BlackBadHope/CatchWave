; CatchWave-specific profile for the Microsoft SysVAD sample (MIT upstream).
; DRAFT: requires WDK validation, kernel tests and Microsoft signing before installation.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/12/2026,0.1.0.0
CatalogFile=CatchWaveAudio.cat
PnpLockDown=1
[Manufacturer]
%Provider%=CatchWave,NT$ARCH$.10.0...22621
[CatchWave.NT$ARCH$.10.0...22621]
%Device%=CatchWaveAudio,ROOT\CatchWaveAudio
[SourceDisksNames]
1="CatchWave Audio",,,
[SourceDisksFiles]
CatchWaveAudio.sys=1
[DestinationDirs]
Audio.Copy=13
[Audio.Copy]
CatchWaveAudio.sys
[CatchWaveAudio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Audio.Copy
AddReg=Audio.AddReg
[Audio.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,CatchWaveAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%
[CatchWaveAudio.NT.Interfaces]
AddInterface=%Audio%,WaveSpeaker,Wave
AddInterface=%Render%,WaveSpeaker,Wave
AddInterface=%Realtime%,WaveSpeaker,Wave
AddInterface=%Audio%,TopologySpeaker,Topology
AddInterface=%TopologyCategory%,TopologySpeaker,Topology
[Wave]
AddReg=Wave.AddReg
[Wave.AddReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Device%
[Topology]
AddReg=Topology.AddReg
[Topology.AddReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Device%
HKR,EP\0,%Association%,,"{00000000-0000-0000-0000-000000000000}"
HKR,EP\0,%EventDriven%,0x00010001,1
[CatchWaveAudio.NT.Services]
AddService=CatchWaveAudio,0x00000002,Audio.Service
[Audio.Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\CatchWaveAudio.sys
[CatchWaveAudio.NT.HW]
AddReg=Audio.Hardware
[Audio.Hardware]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
[CatchWaveAudio.NT.Wdf]
KmdfService=CatchWaveAudio,Audio.Wdf
[Audio.Wdf]
KmdfLibraryVersion=$KMDFVERSION$
[Strings]
Provider="CatchWave"
Device="CatchWave Output"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
TopologyCategory="{DDA54A40-1E4C-11D1-A050-405705C10000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
