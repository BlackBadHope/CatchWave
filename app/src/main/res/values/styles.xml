<resources>
    <style name="AppTheme" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#B9F66B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#101510</item>
        <item name="android:navigationBarColor">#101510</item>
        <item name="android:windowBackground">#101510</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#B9F66B</item>
        <item name="android:windowBackground">#1D241D</item>
        <item name="android:colorBackground">#1D241D</item>
        <item name="android:textColorPrimary">#EEF5E6</item>
        <item name="android:textColorSecondary">#A4B19F</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
